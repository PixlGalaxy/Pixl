# --- Discord -----------------------------------------------------------------
# Main bot: slash commands, Activity, all text messages. It also plays music.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Voice-only node bots (separate Discord applications), comma separated. Optional.
NODE_TOKENS=

# --- Web / Activity ----------------------------------------------------------
PUBLIC_URL=https://lynx.example.com
# HTTP_HOST / HTTP_PORT: only when running the binary without Docker. In the image nginx listens
# on 8080 and the bot always uses 127.0.0.1:4000, whatever is set here.
#HTTP_HOST=127.0.0.1
#HTTP_PORT=4000
APPDATA_DIR=/appdata
DATA_DIR=/data
# Language of the bot's messages (en, es). The panel uses each user's own choice.
BOT_LOCALE=en

# --- Admin panel (optional) --------------------------------------------------
# Operator panel (status, activity, live logs, notices / scheduled downtime, runtime tweaks) on
# container port 8081, separate from the Activity. OFF unless ADMIN_USERNAME and a password are set.
# Keep the published port LAN-only or behind a proxy with an access list.
ADMIN_USERNAME=
# Either a plain password (at least 12 characters; use a long random one)...
ADMIN_PASSWORD=
# ...or, better, an Argon2 hash of it (wins when both are set). Make one with
#   docker compose run --rm -T --entrypoint /app/lynx lynx hash-admin-password
# and keep the single quotes (the hash contains $ signs):
#ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# Session cookie Secure flag: auto (when the request came over HTTPS), true or false.
#ADMIN_COOKIE_SECURE=auto
# Only without Docker (the image always uses 127.0.0.1:4001 behind nginx on 8081):
#ADMIN_HTTP_HOST=127.0.0.1
#ADMIN_HTTP_PORT=4001
# Built admin UI served by the backend itself (Windows dev run; scripts/dev-windows.ps1 sets it).
#ADMIN_WEB_DIR=

# Links shown in the panel (Help) and in bot messages
LANDING_URL=
TERMS_URL=
PRIVACY_URL=
SUPPORT_URL=

# --- Music sources -----------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
# MusicBrainz requires a contact, e.g. "Lynx/1.0 (you@example.com)"
MUSICBRAINZ_USER_AGENT=
# Optional Netscape cookies file for yt-dlp, if YouTube starts asking for verification
YTDLP_COOKIES_FILE=
# Download cap for the yt-dlp fallback (HLS/live streams), like PIXL. Direct streams are paced
# by playback (about 0.15 Mbit/s per song), so they never use more than they play.
YTDLP_LIMIT_RATE=300K
# YouTube player client tried first for stream URLs. visionos URLs play right away; yt-dlp's
# default clients make YouTube hold the URL back for 4-14 s. On failure Lynx retries with the
# default clients. "default" uses only yt-dlp's own choice.
YTDLP_PLAYER_CLIENT=visionos

# --- AI radio (optional) -----------------------------------------------------
# true enables /ai, Like/Dislike buttons and listening history.
# Ollama is optional: without OLLAMA_URL the radio uses only the recommendation algorithm.
AI_ENABLED=false
OLLAMA_URL=
# Preferred model, loaded when no acceptable model is in memory.
OLLAMA_MODEL=
# Comma-separated alternates that are also fine (for a GPU shared with other work). If one of
# them is already loaded it is used as is and nothing else is loaded. Empty: only OLLAMA_MODEL.
OLLAMA_CHECKED_MODELS=
# When loading OLLAMA_MODEL fails (e.g. not enough GPU memory), wait this long, check again and
# retry once; if that fails too the radio goes on with the algorithm alone.
OLLAMA_LOAD_RETRY_SECS=30
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECS=120

# --- Tuning ------------------------------------------------------------------
EMPTY_CHANNEL_TIMEOUT_SECS=180
MAX_CONCURRENT_EXTRACTIONS=8
STREAM_CACHE_MAX_MB=2048
# Upcoming tracks each player prepares ahead while one plays: the stream URL plus the first ~10 s
# of audio, saved under DATA_DIR/streams, so skipping one or several tracks starts at once.
# Prepared one at a time, a few seconds apart. 0 turns it off; at most 5. Default 2.
PREFETCH_TRACKS=2
CACHE_TTL_DAYS=7
# Playlists / albums each user keeps in the panel's Playlists tab (saved when they add one with
# /play or the panel). When full, the least recently used unpinned one is dropped; pinned ones
# are kept, and if every slot is pinned new ones are not saved. 0 turns saving off.
MAX_STORED_PLAYLISTS=20
LOG_LEVEL=info
